PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/quality_education
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRE_IN=7d
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Translation (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Email Configuration (Nodemailer / Mailtrap / Gmail)
MAIL_PROVIDER=sandbox
SANDBOX_MAIL_HOST=sandbox.smtp.mailtrap.io
SANDBOX_MAIL_PORT=2525
SANDBOX_MAIL_USER=your_sandbox_mail_user
SANDBOX_MAIL_PASS=your_sandbox_mail_pass
GMAIL_MAIL_HOST=smtp.gmail.com
GMAIL_MAIL_PORT=587
GMAIL_MAIL_USER=your_gmail_user
GMAIL_MAIL_PASS=your_gmail_app_password

# Google OAuth & Calendar Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-oauth/callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=primary

# Seed users (provide unique non-production credentials when running seed-users.js)
SEED_STUDENT_EMAIL=student_seed@example.test
SEED_STUDENT_PASSWORD=replace_with_strong_student_password
SEED_TUTOR_EMAIL=tutor_seed@example.test
SEED_TUTOR_PASSWORD=replace_with_strong_tutor_password
SEED_PRIMARY_ADMIN_EMAIL=primary_admin_seed@example.test
SEED_PRIMARY_ADMIN_PASSWORD=replace_with_strong_primary_admin_password
SEED_SECONDARY_ADMIN_EMAIL=secondary_admin_seed@example.test
SEED_SECONDARY_ADMIN_PASSWORD=replace_with_strong_secondary_admin_password
